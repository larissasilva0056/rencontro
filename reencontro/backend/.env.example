PORT=3000
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
CORS_ORIGIN=http://localhost:5173        # URL(s) do frontend, separadas por vírgula
PUBLIC_URL=http://localhost:5173         # usada nos links de compartilhamento
ADMIN_EMAIL=admin@reencontro.app
ADMIN_PASSWORD=Admin@12345
SEED_DEMO=true

# ---------- Banco de dados ----------
# Opção A (local, zero configuração): arquivo SQLite
DB_TYPE=sqlite
DB_PATH=reencontro.sqlite
# Opção B: PostgreSQL local (docker compose up -d db) ou na internet (Neon, Supabase, Railway, RDS...)
# DB_TYPE=postgres
# DATABASE_URL=postgresql://reencontro:reencontro@localhost:5432/reencontro
# DB_SSL=true                            # true para bancos na nuvem
DB_SYNC=true                             # em produção use false e migrations

# ---------- Armazenamento de arquivos ----------
# Opção A (local): grava em ./uploads
STORAGE_DRIVER=local
# Opção B (internet): qualquer serviço compatível com S3 (AWS S3, Cloudflare R2, Supabase Storage, Backblaze B2, MinIO)
# STORAGE_DRIVER=s3
# S3_BUCKET=reencontro
# S3_REGION=auto
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com   # vazio para AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev  # URL pública do bucket/CDN
# S3_FORCE_PATH_STYLE=false

# ---------- IA (Google Gemini) ----------
# Chave em https://aistudio.google.com/apikey. Vazio = usa apenas a análise local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
